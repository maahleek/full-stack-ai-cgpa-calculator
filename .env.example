# Postgres connection string used by drizzle + pg
# If you run Postgres via Docker (see SETUP.md), this default matches it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign session JWTs. Generate your own for any real use:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Resend API key for sending password-reset emails. Get one free at https://resend.com
# Without this set, reset links are just logged to the server console instead of emailed —
# fine for local testing, but you'll need a real key for real users.
RESEND_API_KEY=

# Sender shown on reset emails. The default below works out of the box on Resend's
# free tier without verifying your own domain. Replace once you have a verified domain:
#   EMAIL_FROM="GradeLens <noreply@yourdomain.com>"
EMAIL_FROM="GradeLens <onboarding@resend.dev>"

# Base URL used to build password-reset links. Defaults to whatever host the request
# came from if unset, so this is usually only needed in production behind a proxy.
APP_URL=http://localhost:3000

# Google OAuth credentials for "Continue with Google". Get these from
# https://console.cloud.google.com/apis/credentials — see GOOGLE_SIGNIN_SETUP.md.
# Without these set, the Google button will show a clear error instead of crashing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
